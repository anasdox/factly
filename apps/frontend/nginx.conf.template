server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Content-hashed filenames, so a given URL never changes meaning: cache them
    # hard. A miss must 404 rather than fall through to index.html — answering a
    # .js request with HTML turns a stale cache into a silently broken app, which
    # is exactly what it looks like from the browser.
    location /static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The one file that must never be cached: it is what names the current
    # bundles. A stale copy points at bundles that no longer exist, and the app
    # cannot boot until the browser is forced to re-fetch it.
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Every backend call lives under /api/, which no UI route uses: a page such as
    # /documents/<id> or /feedback, opened directly, must reach index.html and
    # never the backend's JSON. The trailing slash on proxy_pass strips /api.
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        client_max_body_size 5m;
        proxy_read_timeout 120s;
    }

    # Server-sent events: one long-lived, unbuffered stream per document.
    location /api/events/ {
        proxy_pass ${BACKEND_URL}/events/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
    }

    # Chat replies stream token by token.
    location /api/chat {
        proxy_pass ${BACKEND_URL}/chat;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
    }

    # Only for the sign-in callback: the identity provider redirects the browser
    # to /auth/<provider>/callback, the address registered with it. Every other
    # auth call goes under /api/auth/.
    location /auth/ {
        proxy_pass ${BACKEND_URL}/auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
