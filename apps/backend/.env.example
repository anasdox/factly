# ── LLM ──
# Provider: openai | anthropic | openai-compatible
LLM_PROVIDER=openai
# API key or access token for the chosen provider
LLM_API_KEY=
# (openai-compatible only) Base URL of the OpenAI-compatible API
# LLM_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# (Optional) Model identifier — each provider has its own default
# LLM_MODEL=gpt-4o
# (Optional) Embedding model for semantic deduplication
# LLM_EMBEDDINGS_MODEL=text-embedding-3-small
# LLM_DEDUP_THRESHOLD=0.75

# ── Search (web research feature) ──
# SEARCH_PROVIDER=brave
# SEARCH_API_KEY=

# ── Authentication ──
# Required for user management. Generate a strong random value.
JWT_SECRET=
# JWT_EXPIRATION=24h

# ── OAuth (optional — if not set, only password login is available) ──
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_CALLBACK_BASE_URL=https://your-domain.com   # required if behind a reverse proxy

# ── Server ──
# PORT=3002
# ENABLE_BENCHMARK=true   # set to true to expose /benchmark endpoints (dev only)
# RATE_LIMIT_LLM=20        # max LLM requests per minute per IP
# RATE_LIMIT_GENERAL=120   # max general requests per minute per IP

# ── Chat ──
# CHAT_CONTEXT_THRESHOLD=50
# CHAT_MAX_HISTORY=10
